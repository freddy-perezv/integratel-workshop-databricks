# Databricks App manifest — read by the runtime when the container starts.
#
# This is the TEMPLATE app.yaml. scripts/finalize_app.sh renders the deployed
# app.yaml from it: keeps this header + command + scopes + binding-derived env,
# and appends the plain-value env vars (DEMO_CATALOG, DASHBOARD_ID,
# GENIE_SPACE_ID, …) harvested from the setup job's export_resources output.
# Plain values live in exactly one place (finalize_app.sh), assembled after
# the job runs — the bundle can't know the Genie/KA/MAS IDs at deploy time.
# Binding-derived vars (DATABRICKS_WAREHOUSE_ID, LAKEBASE_ENDPOINT) stay here.
#
# Lifecycle on the Apps container (in order):
#   1. `npm install` against the shipped lockfile.
#   2. `npm run build` (no-op echo — real build runs locally via
#      scripts/build-app.sh and dist/ ships via DAB sync.include).
#   3. The `command:` below starts the server.

command: ['node', '--env-file-if-exists=.env', 'dist/server.js']

# Scopes minted into the user's OBO token (x-forwarded-access-token).
user_authorization:
  scopes:
    - model-serving      # Claude model endpoint (Chat Completions, not Responses API)
    - sql                # warehouse-backed analytics queries + SQL warehouse for data
    - postgres           # Lakebase pool (retention actions storage)
    - catalog.catalogs:read
    - catalog.schemas:read
    - catalog.tables:read

env:
  - name: NODE_ENV
    value: production

  # Synthetic "cascarón" mode — 1 seeds a hero dataset at boot; 0 syncs the
  # real Delta gold tables (below) instead. Now wired to the real catalog.
  - name: SEED_SYNTHETIC
    value: "0"

  # Integratel catalog data — integratel_dev.gold holds the synth data for this workshop.
  # Production will use integratel_prod.gold with the same schema.
  # syncFromDelta pulls cliente_360, tickets_enriquecidos, nodos_salud at boot.

  # ── Binding-derived ─────────────────────────────────────────────────
  # AppKit's ResourceRegistry expects DATABRICKS_WAREHOUSE_ID and the
  # standard PG* vars from the postgres binding (PGHOST/PGDATABASE/PGUSER
  # /PGPORT/PGSSLMODE are auto-injected by the platform).
  - name: DATABRICKS_WAREHOUSE_ID
    valueFrom: sql-warehouse
  - name: LAKEBASE_ENDPOINT
    valueFrom: postgres
  # Mirror DATABRICKS_WAREHOUSE_ID into WAREHOUSE_ID for config/app.json
  # placeholder resolution.
  - name: WAREHOUSE_ID
    valueFrom: sql-warehouse
