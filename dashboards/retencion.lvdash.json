{
  "datasets": [
    {
      "name": "kpi_riesgo",
      "displayName": "kpi_riesgo",
      "queryLines": [
        "SELECT MEASURE(clientes_riesgo_alto) AS clientes_riesgo_alto,\n",
        "       MEASURE(renta_en_riesgo) AS renta_en_riesgo,\n",
        "       MEASURE(consultas_portabilidad) AS consultas_portabilidad,\n",
        "       MEASURE(clientes) AS clientes_activos\n",
        "FROM gold.mv_riesgo_clientes\n"
      ]
    },
    {
      "name": "kpi_churn",
      "displayName": "kpi_churn",
      "queryLines": [
        "SELECT MEASURE(tasa_churn) AS tasa_churn_sep, MEASURE(bajas_portabilidad) AS bajas_portabilidad_sep\n",
        "FROM gold.mv_churn WHERE mes = DATE'2026-09-01'\n"
      ]
    },
    {
      "name": "riesgo_zona",
      "displayName": "riesgo_zona",
      "queryLines": [
        "SELECT concat(region, ' · ', distrito) AS zona, nivel_riesgo, MEASURE(clientes) AS clientes\n",
        "FROM gold.mv_riesgo_clientes WHERE nivel_riesgo <> 'Bajo' GROUP BY ALL\n"
      ]
    },
    {
      "name": "riesgo_nivel",
      "displayName": "riesgo_nivel",
      "queryLines": [
        "SELECT nivel_riesgo, MEASURE(clientes) AS clientes FROM gold.mv_riesgo_clientes\n",
        "WHERE nivel_riesgo <> 'Bajo' GROUP BY ALL\n"
      ]
    },
    {
      "name": "fallas_diarias",
      "displayName": "fallas_diarias",
      "queryLines": [
        "SELECT fecha, region, MEASURE(fallas_red) AS fallas_red\n",
        "FROM gold.mv_soporte WHERE fecha >= DATE'2026-09-01' GROUP BY ALL ORDER BY fecha\n"
      ]
    },
    {
      "name": "churn_mes",
      "displayName": "churn_mes",
      "queryLines": [
        "SELECT mes, region, MEASURE(tasa_churn) AS tasa_churn\n",
        "FROM gold.mv_churn WHERE mes < DATE'2026-10-01' GROUP BY ALL ORDER BY mes\n"
      ]
    },
    {
      "name": "reclamos_mes",
      "displayName": "reclamos_mes",
      "queryLines": [
        "SELECT mes, tipo, MEASURE(reclamos) AS reclamos FROM gold.mv_reclamos GROUP BY ALL ORDER BY mes\n"
      ]
    },
    {
      "name": "nodos",
      "displayName": "nodos",
      "queryLines": [
        "SELECT nodo_id, region, distrito, tecnologia, estado_salud, fallas_red_7d, fallas_red_30d,\n",
        "       ultima_incidencia, clientes_riesgo_alto, renta_en_riesgo\n",
        "FROM gold.nodos_salud ORDER BY fallas_red_30d DESC\n"
      ]
    },
    {
      "name": "top_clientes",
      "displayName": "top_clientes",
      "queryLines": [
        "SELECT cliente_id, nombre_completo, distrito, segmento_valor, plan_hogar, renta_mensual,\n",
        "       score_riesgo, nivel_riesgo, consulta_portabilidad_30d, reclamos_abiertos\n",
        "FROM gold.cliente_360 WHERE estado = 'Activo' AND nivel_riesgo IN ('Crítico', 'Alto')\n",
        "ORDER BY score_riesgo DESC, renta_mensual DESC LIMIT 25\n"
      ]
    }
  ],
